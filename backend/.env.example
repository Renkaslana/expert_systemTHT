# ─────────────────────────────────────────────────────────────────
# Diagnova Backend — Environment Configuration
# Copy to .env and adjust values for your local setup.
# ─────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3001

# Database — PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnova?schema=public"

# CORS — Frontend origin allowed to access this API
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
